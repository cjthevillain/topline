{
  "name": "topline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn a company CSV into an SEO-optimised, server-rendered blog page.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "tokens": "node scripts/build-tokens.mjs",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "nuxt": "^4.6.3",
    "papaparse": "^5.7.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
