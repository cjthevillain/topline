# Everything here is optional. With no LLM set, pages are still generated from
# the data template, so the app works with no keys at all.

# Claude through the Anthropic API. Tried first when a key is set.
NUXT_ANTHROPIC_API_KEY=
NUXT_ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI-compatible provider (Groq by default). Set a model to turn it on.
NUXT_LLM_NAME=groq
NUXT_LLM_BASE_URL=https://api.groq.com/openai/v1
NUXT_LLM_API_KEY=
NUXT_LLM_MODEL=

# Local Ollama instead:
# NUXT_LLM_NAME=ollama
# NUXT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# NUXT_LLM_MODEL=llama3.2:3b

# Google Gemini, tried after the provider above when set.
# The free tier cannot serve UK or EEA users: check Google's terms first.
NUXT_GEMINI_API_KEY=
NUXT_GEMINI_MODEL=gemini-2.5-flash

# Limits in milliseconds: one LLM call, then all calls for one page together.
# Keep the budget under the proxy's request limit (100 seconds on Cloudflare).
NUXT_LLM_TIMEOUT_MS=25000
NUXT_LLM_BUDGET_MS=50000

# Daily caps on the public upload.
NUXT_DAILY_PAGE_LIMIT=100
NUXT_IP_DAILY_LIMIT=20

# Canonical origin, for example https://topline.example. Defaults to the request origin.
NUXT_PUBLIC_SITE_URL=
